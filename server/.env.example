# All optional — the app runs fully offline with defaults.
PORT=4000
JWT_SECRET=change-me-in-production
APP_URL=http://localhost:5173          # used in password-reset and invoice email links
# DB_PATH=./data/brightloop.db
# BILLING_INTERVAL_MS=3600000          # scheduler frequency (default hourly)
# SMTP — leave unset to log emails to the Outbox page instead of sending
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Brightloop Billing <billing@brightloop.io>"
