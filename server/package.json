{
  "name": "brightloop-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --no-warnings --test --test-concurrency=1 test/*.test.js",
    "start": "node --no-warnings --env-file-if-exists=.env src/index.js",
    "dev": "node --no-warnings --env-file-if-exists=.env --watch src/index.js",
    "seed": "node --no-warnings src/seed.js",
    "seed:bulk": "node --no-warnings src/seed.js --bulk",
    "test:perf": "node --no-warnings test/perf.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
